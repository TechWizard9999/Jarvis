# Copy to .env. Keep credentials in .secrets/, never in this file.
BUGFIX_PROJECT_DIR=/absolute/path/to/Automation
BUGFIX_REPO_ROOT=/absolute/path/to/Automation/repos
BUGFIX_STATE_DIR=/absolute/path/to/Automation/state
BUGFIX_PORT=3210
BUGFIX_MODEL=nim/nvidia/nemotron-3-ultra-550b-a55b
BUGFIX_MODEL_TEMPERATURE=1
BUGFIX_MODEL_TOP_P=0.95
BUGFIX_MODEL_THINKING=true
# Requested where supported; known NVIDIA V2 budget rejection is recorded and retried without that field.
BUGFIX_REASONING_BUDGET=16384
BUGFIX_MODEL_CONTEXT=262144
BUGFIX_MODEL_INPUT=196608
BUGFIX_MODEL_MAX_OUTPUT=24576
# OpenCode 1.19.3 compacts at input minus reserved (188416 counted tokens with these defaults).
BUGFIX_COMPACTION_RESERVED=8192
# Large-context experiments configure capacity; this does not verify endpoint support.
BUGFIX_ALLOW_UNVERIFIED_CONTEXT=false
# Research only: both this opt-in and BUGFIX_REASONING_BUDGET=-1 are required.
# Normal phase policy requests bounded reasoning. If the endpoint rejects the budget,
# the gateway records its omission; final-answer/tool-call room then cannot be enforced.
BUGFIX_ALLOW_UNBOUNDED_REASONING=false
BUGFIX_FORK=YOUR_USERNAME/rtk
BUGFIX_GIT_NAME=Your Name
BUGFIX_GIT_EMAIL=you@example.com
BUGFIX_RUST_TOOLCHAIN=1.99.1
BUGFIX_COMMAND_TIMEOUT_MS=900000
BUGFIX_MEMORY=4g
BUGFIX_CPUS=2
# Set to the active Docker context socket on macOS if not /var/run/docker.sock.
DOCKER_SOCKET=/var/run/docker.sock

# Extension points. Profile files live in profiles/<name>.json.
BUGFIX_PROFILE_NAME=rtk
BUGFIX_PROVIDER_BASE_URL=https://integrate.api.nvidia.com/v1/
BUGFIX_MAX_ATTEMPTS=6
BUGFIX_NETWORK=bugfix-control
BUGFIX_CONTROLLER_IMAGE=bugfix-controller:0.1
BUGFIX_WORKER_IMAGE=bugfix-worker:0.1
BUGFIX_AGENT_IMAGE=bugfix-opencode:0.1
BUGFIX_PUBLISHER_IMAGE=bugfix-publisher:0.1
